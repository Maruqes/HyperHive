{
  "date": "2026-10-19",
  "scope": "Selected MCP feature implementation and prior registry integration; local source/disposable fixture validation only",
  "checks": {
    "mcp_full_tests": true,
    "mcp_full_race": true,
    "mcp_vet": true,
    "master_api_services_virsh_protocol_tests": true,
    "master_nginx_regressions": true,
    "master_api_services_race": true,
    "master_vet": true,
    "slave_snapshot_tests": true,
    "slave_snapshot_race": true,
    "slave_virsh_vet": true,
    "generated_rpc_compile": true,
    "diff_whitespace": true
  },
  "additional_regressions": "exact full-int64 VM/Notes/ISO IDs; raw fractional/overflow/root rejection; schema parity; proxy numeric union/metadata; primary-disk recovery; DNS safe writes; proxy list precision",
  "commands": {
    "mcp": [
      "go test ./... -count=1",
      "go test -race ./... -count=1",
      "go vet ./..."
    ],
    "master": [
      "go test ./api ./services ./virsh ./protocol ./api/npmapi ./npm -count=1",
      "go test -race ./api ./services ./virsh ./protocol -count=1",
      "go vet ./api ./services ./virsh ./protocol ./api/npmapi ./npm"
    ],
    "slave": [
      "go test ./virsh -run '^Test(VMSnapshot|HostBoot)' -count=1",
      "go test -race ./virsh -run '^Test(VMSnapshot|HostBoot)' -count=1",
      "go vet ./virsh"
    ],
    "api": [
      "go test ./proto/virsh -count=1"
    ],
    "repository": [
      "git diff --check"
    ]
  },
  "production_access": false,
  "deployment": false
}
