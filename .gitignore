#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum
docker-compose.yml
# env file

# Editor/IDE
# .idea/
# .vscode/

#env files
.env
slave/.env
master/.env

#executables
512SvMan
master/512SvMan
slave/slave

npm-data/
npm-ssl/
master/npm-data/
master/npm-ssl/
master/geoipdb/
master/wireguard/keys/

data.db
novnc
master/novnc
certs/
downloads/
slave/docker_git

data.db-shm
data.db-wal

master/data.db-shm
master/data.db-wal

data.db
data.db-wal
data.db-shm
*.db
*.db.bak
*.db-wal
*.db-shm

# Private NPM upgrade backups and preserved rollback state.
npm-update-backups/
512SvMan.npm-previous
npm-data.before-rollback-*/
npm-ssl.before-rollback-*/
data.db*.before-rollback-*
docker-compose.hyperhive-upstreams.yml
docker-compose.hyperhive-upstreams.yml.before-rollback-*
